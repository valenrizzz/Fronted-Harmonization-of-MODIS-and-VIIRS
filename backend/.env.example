# Copiar a backend/.env y ajustar. Todas las variables son opcionales.

# Carpeta con una subcarpeta por región (cada una con su manifest.json)
FIRE_API_DATA_ROOT=../Datos_Para_La_Web

# Orígenes permitidos por CORS, separados por coma
FIRE_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Máximo de celdas H3 por respuesta de /spatial/cells (si se supera, se pasa a una resolución más gruesa)
FIRE_API_MAX_CELLS=20000

# Recursos de DuckDB
FIRE_API_DUCKDB_THREADS=4
FIRE_API_DUCKDB_MEMORY_LIMIT=1GB

# Cada cuántos segundos se revisa si cambió algún manifest.json (regiones nuevas o actualizadas)
FIRE_API_RELOAD_CHECK_SECONDS=30

# Cache-Control max-age (segundos) de las respuestas de datos
FIRE_API_CACHE_MAX_AGE=300
