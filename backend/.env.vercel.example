# Variables de entorno del proyecto BACKEND en Vercel
# (Settings → Environment Variables). No contienen secretos.

# Los datos se copian a backend/data_bundle en el build (ver vercel.json)
FIRE_API_DATA_ROOT=data_bundle

# Único directorio escribible en Vercel: ahí va el catálogo de vistas de DuckDB
FIRE_API_CATALOG_DIR=/tmp/fire-api-cache

# URL de producción del frontend (reemplazar por la real) + previews de Vercel
FIRE_API_CORS_ORIGINS=https://TU-FRONTEND.vercel.app
FIRE_API_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# La función tiene 1024 MB: DuckDB usa como máximo la mitad
FIRE_API_DUCKDB_MEMORY_LIMIT=512MB
FIRE_API_DUCKDB_THREADS=2

FIRE_API_MAX_CELLS=20000
FIRE_API_CACHE_MAX_AGE=300
